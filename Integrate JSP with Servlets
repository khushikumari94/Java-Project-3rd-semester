Step 2: Create a HotelManager Class
This class will manage room availability and bookings.

package com.hotelmanagement;

import java.util.ArrayList;
import java.util.List;

public class HotelManager {
    private List<Room> rooms;

    // Constructor initializing rooms
    public HotelManager() {
        rooms = new ArrayList<>();
        rooms.add(new Room(101, "Single", true, 100.0));
        rooms.add(new Room(102, "Double", true, 150.0));
        rooms.add(new Room(103, "Suite", true, 300.0));
    }

    // Get list of available rooms
    public List<Room> getAvailableRooms() {
        List<Room> availableRooms = new ArrayList<>();
        for (Room room : rooms) {
            if (room.isAvailable()) {
                availableRooms.add(room);
            }
        }
        return availableRooms;
    }

    // Book a room by its room number
    public boolean bookRoom(int roomNumber) {
        for (Room room : rooms) {
            if (room.getRoomNumber() == roomNumber && room.isAvailable()) {
                room.setAvailable(false); // Mark as booked
                return true;
            }
        }
        return false; // Room not available
    }
}

Step 3: Create the HotelServlet Class
The HotelServlet will handle HTTP requests, interact with HotelManager to get available rooms or process bookings, 
and forward the result to a JSP for rendering.

package com.hotelmanagement;

import java.io.*;
import javax.servlet.*;
import javax.servlet.http.*;
import java.util.List;

public class HotelServlet extends HttpServlet {
    private HotelManager hotelManager;

    public void init() {
        hotelManager = new HotelManager();
    }

    // Handle GET requests (Display available rooms)
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        List<Room> availableRooms = hotelManager.getAvailableRooms();
        request.setAttribute("availableRooms", availableRooms);  // Set available rooms as request attribute
        RequestDispatcher dispatcher = request.getRequestDispatcher("/index.jsp");
        dispatcher.forward(request, response);
    }

    // Handle POST requests (Book a room)
    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        int roomNumber = Integer.parseInt(request.getParameter("roomNumber"));  // Get room number from request
        boolean success = hotelManager.bookRoom(roomNumber);  // Try to book the room
        if (success) {
            request.setAttribute("message", "Room " + roomNumber + " booked successfully.");
        } else {
            request.setAttribute("message", "Room " + roomNumber + " is not available.");
        }
        RequestDispatcher dispatcher = request.getRequestDispatcher("/confirmation.jsp");
        dispatcher.forward(request, response);  // Forward to confirmation JSP
    }
}


Step 4: Create the index.jsp (Form to Display Available Rooms)
This page will display available rooms and allow users to book a room.

<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<html>
<head>
    <title>Hotel Management - Available Rooms</title>
</head>
<body>
    <h1>Available Rooms</h1>
    <table border="1">
        <thead>
            <tr>
                <th>Room Number</th>
                <th>Room Type</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <c:forEach var="room" items="${availableRooms}">
                <tr>
                    <td>${room.roomNumber}</td>
                    <td>${room.roomType}</td>
                    <td>${room.price}</td>
                    <td>
                        <form action="HotelServlet" method="post">
                            <input type="hidden" name="roomNumber" value="${room.roomNumber}"/>
                            <input type="submit" value="Book Now"/>
                        </form>
                    </td>
                </tr>
            </c:forEach>
        </tbody>
    </table>
</body>
</html>


Step 5: Create the confirmation.jsp (Booking Confirmation)
This page will show whether the room booking was successful.

<%@ page contentType="text/html;charset=UTF-8" language="java" %>
