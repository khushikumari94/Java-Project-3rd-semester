Creating and configuring servlets for a hotel management project involves the following key steps:
1-Setting up the Java Servlet Environment: To use servlets, ensure that you have a Java development 
environment (like Eclipse or IntelliJ IDEA) set up with a servlet container, such as Apache Tomcat.
2-Project Structure: The servlet files will typically be part of a WebApplication with the following structure:
HotelManagement
├── src
│   └── com
│       └── hotel
│           └── servlet
│               ├── AddBookingServlet.java
│               └── ViewBookingServlet.java
├── WebContent
│   ├── WEB-INF
│   │   └── web.xml
│   ├── index.jsp
│   ├── addBooking.jsp
│   └── viewBooking.jsp
└── lib
3-Servlet Configuration in web.xml: You need to define the servlet in the web.xml file, which is typically located under WEB-INF.
Example Servlet: AddBookingServlet.java
This servlet would handle the logic for adding a booking for the hotel.
package com.hotel.servlet;

import java.io.*;
import javax.servlet.*;
import javax.servlet.http.*;
import java.sql.*;

public class AddBookingServlet extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        String customerName = request.getParameter("customerName");
        String roomType = request.getParameter("roomType");
        String checkInDate = request.getParameter("checkInDate");
        String checkOutDate = request.getParameter("checkOutDate");

        try {
            // Create a connection to the database (replace with your own JDBC URL, username, and password)
            Connection conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/hotel_db", "root", "password");
            String query = "INSERT INTO bookings (customer_name, room_type, check_in_date, check_out_date) VALUES (?, ?, ?, ?)";
            PreparedStatement pstmt = conn.prepareStatement(query);
            pstmt.setString(1, customerName);
            pstmt.setString(2, roomType);
            pstmt.setString(3, checkInDate);
            pstmt.setString(4, checkOutDate);
            
            int result = pstmt.executeUpdate();
            
            if (result > 0) {
                response.sendRedirect("viewBooking.jsp"); // Redirect to view bookings page
            } else {
                request.setAttribute("message", "Booking failed!");
                RequestDispatcher dispatcher = request.getRequestDispatcher("addBooking.jsp");
                dispatcher.forward(request, response);
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
Example Servlet: ViewBookingServlet.java
This servlet would fetch and display all bookings in the hotel.
package com.hotel.servlet;

import java.io.*;
import javax.servlet.*;
import javax.servlet.http.*;
import java.sql.*;
import java.util.*;

public class ViewBookingServlet extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        List<String> bookings = new ArrayList<>();
        
        try {
            // Create a connection to the database
            Connection conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/hotel_db", "root", "password");
            String query = "SELECT * FROM bookings";
            Statement stmt = conn.createStatement();
            ResultSet rs = stmt.executeQuery(query);

            while (rs.next()) {
                String bookingDetails = rs.getInt("id") + " - " + rs.getString("customer_name") + " (" + rs.getString("room_type") + ")";
                bookings.add(bookingDetails);
            }
            
            request.setAttribute("bookings", bookings);
            RequestDispatcher dispatcher = request.getRequestDispatcher("viewBooking.jsp");
            dispatcher.forward(request, response);
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
web.xml Configuration
In the WEB-INF/web.xml file, you need to configure these servlets so that they are mapped to URLs.
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <!-- Servlet mapping for AddBookingServlet -->
    <servlet>
        <servlet-name>AddBookingServlet</servlet-name>
        <servlet-class>com.hotel.servlet.AddBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddBookingServlet</servlet-name>
        <url-pattern>/addBooking</url-pattern>
    </servlet-mapping>

    <!-- Servlet mapping for ViewBookingServlet -->
    <servlet>
        <servlet-name>ViewBookingServlet</servlet-name>
        <servlet-class>com.hotel.servlet.ViewBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewBookingServlet</servlet-name>
        <url-pattern>/viewBooking</url-pattern>
    </servlet-mapping>

</web-app>

